rules_version = '2';
// Café Reza — standalone Firebase build (project cafe-reza, Firestore
// asia-south1, database (default)). Deploy with:
//   firebase deploy --only firestore:rules,storage
//   (Firebase CLI, signed in as the project owner.)
//
// Deny by default. Roles come from the caller's /users/{uid} document
// (`role`: admin | manager | cashier | kitchen | waiter | delivery |
// inventory | customer), falling back to the Firebase Auth custom claim
// `role` when the owner sets one with the Admin SDK. The owner email
// below is the pinned Super Admin from the cafe's own records: only
// that email may create its own users document with role "admin"
// (first-admin bootstrap, no service account needed). The pinned
// customer email may never be given a staff role. Prices, stock and
// payment status are never writable by customers: catalog/settings
// writes are admin-only, and only managers/admins change payment
// status. Totals are computed in the app from the Firestore product
// documents it has just read at checkout and must be verified by staff
// before an order is confirmed — there is no Cloud Function in this
// Spark-plan build to recompute them server-side (see README.md).
//
// Ordering and reservations need a signed-in account. Firestore rules
// cannot verify a phone number without a server, so guest checkout
// would leave every guest order readable by anyone; signed-in orders
// stay private to their owner and staff. Google sign-in is one tap.
//
// These rules are NOT live until deployed. Until then Firestore stays
// in Production mode (all reads/writes denied) and the app reports
// that honestly instead of pretending the connection works.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() {
      return signedIn() && request.auth.token.keys().hasAny(['role'])
        ? request.auth.token.role
        : (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : null);
    }
    function isAdmin() { return userRole() == 'admin'; }
    function isManager() { return userRole() == 'manager' || isAdmin(); }
    function isStaff() { return userRole() in ['admin', 'manager', 'cashier', 'kitchen', 'waiter', 'delivery', 'inventory']; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isOwnerEmail() { return signedIn() && request.auth.token.email == 'rezamdyeasin@gmail.com'; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: each user reads/updates only their own profile, and may
    // never change role, loyalty points, status or email on their own.
    // Admins manage roles/status, but can never move the pinned owner
    // off admin or the pinned customer onto a staff role.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && (request.resource.data.email == request.auth.token.email
          || request.resource.data.email == request.auth.token.phone_number)
        && (request.resource.data.role == 'customer' || (isOwnerEmail() && request.resource.data.role == 'admin'))
        && !request.resource.data.keys().hasAny(['loyaltyPoints', 'status']);
      allow update: if (isOwner(userId)
          && !changedKeys().hasAny(['role', 'loyaltyPoints', 'status', 'email']))
        || (isAdmin()
          && request.resource.data.email == resource.data.email
          && !(resource.data.email == 'rezamdyeasin@gmail.com' && request.resource.data.role != 'admin')
          && !(resource.data.email == 'yeasinreza81@gmail.com' && request.resource.data.role != 'customer'));
      allow delete: if false;
    }

    // Catalog + settings + coupons: public read; only admins write.
    // The customer site reads these live, so every admin edit here
    // controls the customer panel at once — there is no second copy.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: customers create only their own orders, always Pending /
    // Unpaid. Staff read all; only staff change status; only
    // admin/manager change payment status; totals and items are never
    // editable after creation.
    match /orders/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items.size() > 0
        && request.resource.data.keys().hasAll(['customerName', 'phone', 'items', 'total'])
        && (isStaff() || (request.resource.data.status == 'Pending' && request.resource.data.paymentStatus == 'Unpaid'));
      allow update: if isStaff()
        && !changedKeys().hasAny(['total', 'subtotal', 'discount', 'vat', 'deliveryFee', 'items', 'userId'])
        && !(changedKeys().hasAny(['paymentStatus']) && !isManager());
      allow delete: if false;
    }

    // Reservations: signed-in customers create their own; staff manage all.
    match /reservations/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Private messages: the customer who owns the thread and staff only.
    match /messages/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if false;
    }

    // Support tickets: signed-in customers create their own; staff reply.
    match /tickets/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Reviews: anyone reads approved reviews; customers create their
    // own pending reviews; staff moderate.
    match /reviews/{id} {
      allow read: if resource.data.status == 'Approved' || isStaff();
      allow create: if signedIn() && request.resource.data.status == 'Pending';
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Tables, shifts: staff areas.
    match /tables/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }
    match /shifts/{id} {
      allow read, write: if isStaff();
    }

    // Refund requests: staff create, admin/manager decide, nobody edits
    // a decided request.
    match /refundRequests/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'pending';
      allow update: if isManager() && resource.data.status == 'pending';
      allow delete: if false;
    }

    // Inventory & suppliers: staff areas only; cost data is never public.
    match /inventory/{id} {
      allow read, write: if isStaff();
    }
    match /suppliers/{id} {
      allow read, write: if isStaff();
    }
    match /expenses/{id} {
      allow read, write: if isManager();
    }

    // Audit log: append-only. Staff/admin read; only admins create;
    // updates and deletes forbidden.
    match /auditLogs/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Sync metadata (last catalog seed / publish).
    match /meta/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
