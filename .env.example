# Copy to .env (or set the same names in Firebase Hosting / build env).
# Values come ONLY from Firebase Console → Project settings → Your apps →
# "Cafe Reza Web". Never commit real values. No value is baked into source.
# Until these are set, the app shows the setup notice and Firestore stays
# unreachable — it never pretends to be connected.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cafe-reza.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cafe-reza
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: App Check reCAPTCHA Enterprise site key (Firebase Console → App Check).
VITE_FIREBASE_APPCHECK_KEY=
