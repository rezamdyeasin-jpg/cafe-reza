# Copy to .env (or set the same keys in your hosting provider's dashboard).
# No value here is a secret that ships in code — real keys live only in
# environment/secret settings. Leave the Firebase keys empty to stay in
# Demo Mode (the app's own server actions + database, no live Firebase).

# Public base URL of this deployment. Leave empty to use "whatever domain
# serves the page" — the app uses relative URLs only, so a custom domain
# works without rebuilding. Set it only if an absolute URL is needed
# (e.g. for emails / metadata generated outside the page).
VITE_APP_URL=

# Firebase web config (Firebase console > Project settings > Your apps > Web).
# Project already created: cafe-reza. These values live ONLY in the
# hosting environment / secret settings — never commit a real key
# here and never bake one into client source. The server reads them
# from the hosting environment and hands the web config to the client
# at runtime (see the firebaseConfig privileged handler). Until they
# are set, Firebase Auth reports honestly that it is not configured
# and the app runs on its own server actions + database in Demo Mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=cafe-reza
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA Enterprise site key from Firebase Console > App Check).
# Leave empty to keep App Check off. Never commit a real key here — set it
# in the hosting provider's environment/secret settings only.
VITE_FIREBASE_APPCHECK_KEY=

# Email provider for registration OTP codes (Resend HTTP API).
# No values here — set these ONLY in the hosting provider's
# environment/secret settings after verifying a sender domain/email
# in Resend. Without them, OTP emails are not sent and the app says so.
# RESEND_API_KEY=
# RESEND_FROM=cafe@example.com

# Payment gateway (ONLY after Demo Mode verification — see README.md).
# Never put live merchant secrets in this file or in client code.
# BKASH_MERCHANT_KEY=
# NAGAD_MERCHANT_KEY=
# SSLCOMMERZ_STORE_ID=
